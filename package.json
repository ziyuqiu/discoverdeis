{
  "name": "discoverdeis",
  "version": "1.0.0",
  "description": "Navigation and location finding web application for Brandeis University",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "meteor run",
    "lint": "eslint ."
  },
  "keywords": [
    "meteor",
    "brandeis",
    "navigation",
    "maps",
    "campus"
  ],
  "author": "Brandeis University JBS Team",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "server/**/*.js",
      "!server/lib/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ziyuqiu/discoverdeis.git"
  }
}
